            line-height: 1;
            font-weight: 500;
            color: #333;
            letter-spacing: -0.05em;
            margin-bottom: 1rem;
        }
        .preloader-bar-bg {
            width: 100%;
            height: 2px;
            background-color: #111;
            position: relative;
            overflow: hidden;
        }
        .preloader-bar-fill {
            position: absolute;
            top: 0; left: 0; height: 100%; width: 0%;
            background-color: #333;
            transition: width 0.1s linear;
        }
        
        /* Стили левой части */
        .left-side-bg {
            background-image: linear-gradient(rgba(0,0,0,0.0), rgba(0,0,0,0.2)),
